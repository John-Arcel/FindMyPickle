@page "/login"

<PageTitle>Sign In | FindMyPickle Tournaments</PageTitle>

<div class="min-h-[85vh] flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
        
        <!-- Header Strip -->
        <div class="bg-gradient-to-r from-[#11418e] to-[#1c64d8] text-white p-6 text-center">
            <div class="inline-flex items-center gap-2 mb-2">
                <div class="bg-white text-[#11418e] font-black italic px-2 py-0.5 rounded text-sm shadow-inner">
                    FMP
                </div>
                <span class="font-bold text-base tracking-tight">
                    FindMyPickle<span class="text-blue-200 font-light">Tournaments</span>
                </span>
            </div>
            <h2 class="text-xl font-bold tracking-tight">Welcome Back</h2>
            <p class="text-xs text-blue-100 mt-1">Sign in to manage tournament registrations and schedules</p>
        </div>

        <!-- Form Body -->
        <form class="p-6 sm:p-8 space-y-4 text-xs">
            <div>
                <label class="block font-semibold text-gray-700 mb-1">Email Address</label>
                <input 
                    type="email" 
                    placeholder="player@example.com" 
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none transition" 
                />
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="font-semibold text-gray-700">Password</label>
                    <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">Forgot password?</a>
                </div>
                <input 
                    type="password" 
                    placeholder="••••••••" 
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none transition" 
                />
            </div>

            <div class="flex items-center">
                <input 
                    id="remember-me" 
                    type="checkbox" 
                    class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" 
                />
                <label for="remember-me" class="ml-2 block text-gray-600">
                    Keep me signed in on this device
                </label>
            </div>

            <!-- Login Button -> Navigate to Home -->
            <a 
                href="/home" 
                class="w-full py-2.5 px-4 bg-[#124b9e] hover:bg-blue-700 text-white font-bold rounded-lg shadow transition flex items-center justify-center gap-1.5 mt-2 text-xs text-center"
            >
                <span>Sign In</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>

            <!-- Link to Home directly -->
            <div class="text-center pt-1">
                <a href="/home" class="text-gray-500 hover:text-gray-800 text-[11px] underline">
                    Return to Tournament Board →
                </a>
            </div>

            <!-- Link back to Register -->
            <p class="text-center text-gray-500 text-[11px] pt-3 border-t border-gray-100">
                Don't have an account yet? 
                <a href="/" class="text-blue-600 font-bold hover:underline ml-1">Create an account</a>
            </p>
        </form>

    </div>
</div>
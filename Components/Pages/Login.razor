
@page "/login"

<PageTitle>Sign In | FindMyPickle Tournaments</PageTitle>

<!-- Navigation Bar -->
<nav class="bg-[#124b9e] text-white shadow-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="flex items-center h-14">
            <a href="/home" class="flex items-center gap-2">
                <div class="bg-white text-[#124b9e] font-extrabold italic px-2 py-0.5 rounded tracking-tighter text-xl flex items-center shadow-inner">
                    FMP
                </div>

                <span class="font-bold tracking-tight text-lg hidden sm:inline">
                    FindMyPickle<span class="text-blue-200 font-light">Tournaments</span>
                </span>
            </a>
        </div>
    </div>
</nav>

<!-- Login Section with Full Background Image -->
<div class="min-h-[85vh] flex items-center justify-center px-4 py-12 relative overflow-hidden">

    <!-- Background Image: Covers the Entire White Space -->
    <div class="absolute inset-0 z-0">
        <img
            src="/images/pickleball-background.png"
            alt=""
            class="w-full h-full object-cover"
        />
    </div>

    <!-- White Overlay: Makes the Background Faded -->
    <div class="absolute inset-0 bg-white/70 z-0"></div>

    <!-- Login Card -->
    <div class="max-w-md w-full bg-white/90 rounded-2xl shadow-xl border border-gray-100 overflow-hidden relative z-10">

        <!-- Login Header -->
        <div class="bg-[#124b9e] text-white px-6 py-6 text-center">
            <div class="flex justify-center mb-3">
                <div class="bg-white text-[#124b9e] font-extrabold italic px-3 py-1 rounded tracking-tighter text-2xl shadow-inner">
                    FMP
                </div>
            </div>

            <h1 class="text-xl font-bold">Welcome Back!</h1>

            <p class="text-blue-100 text-xs mt-1">
                Sign in to find your next tournament.
            </p>
        </div>

        <!-- Login Form -->
        <form class="p-6 sm:p-8 space-y-4 text-xs">

            <!-- Email Address -->
            <div>
                <label class="block font-semibold text-gray-700 mb-1">
                    Email Address
                </label>

                <input
                    type="email"
                    placeholder="player@example.com"
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-xs bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                />
            </div>

            <!-- Password -->
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="font-semibold text-gray-700">
                        Password
                    </label>

                    <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">
                        Forgot password?
                    </a>
                </div>

                <input
                    type="password"
                    placeholder="••••••••"
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-xs bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                />
            </div>

            <!-- Remember Me -->
            <div class="flex items-center">
                <input
                    id="remember-me"
                    type="checkbox"
                    class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                />

                <label for="remember-me" class="ml-2 block text-gray-600">
                    Keep me signed in on this device
                </label>
            </div>

            <!-- Sign In Button -->
            <a
                href="/home"
                class="w-full py-2.5 px-4 bg-[#124b9e] hover:bg-blue-700 text-white font-bold rounded-lg shadow transition flex items-center justify-center gap-1.5 mt-2 text-xs text-center"
            >
                <span>Sign In</span>

                <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                </svg>
            </a>

            <!-- Return to Tournament Board -->
            <div class="text-center pt-1">
                <a
                    href="/home"
                    class="text-gray-500 hover:text-gray-800 text-[11px] underline"
                >
                    Return to Tournament Board →
                </a>
            </div>

            <!-- Register Link -->
            <p class="text-center text-gray-500 text-[11px] pt-3 border-t border-gray-200">
                Don't have an account yet?

                <a
                    href="/"
                    class="text-blue-600 font-bold hover:underline ml-1"
                >
                    Create an account
                </a>
            </p>

        </form>
    </div>
</div>

<!-- Footer -->
<footer class="bg-[#0b2b63] text-gray-300 text-xs py-8 px-4 sm:px-8 mt-auto border-t border-blue-900">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">

        <!-- Footer Logo -->
        <div class="flex items-center gap-2">
            <div class="bg-white text-[#0b2b63] font-black italic px-2 py-0.5 rounded text-sm">
                FMP
            </div>

            <span class="font-bold text-white text-sm">
                FindMyPickle<span class="text-blue-200 font-light">Tournaments</span>
            </span>
        </div>

        <!-- Creator -->
        <p class="text-gray-400 text-[11px] text-center">
            Made by
            <span class="text-white font-semibold">John Arcel Sabagkit</span>
        </p>

        <!-- Copyright -->
        <p class="text-gray-500 text-[11px] text-center">
            © 2026 FindMyPickle Tournaments. All rights reserved.
        </p>
    </div>
</footer>
